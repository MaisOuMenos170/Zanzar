    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lero uses your location to center the map and confirm you're near a place when you check in."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Lero usa sua localização para centralizar o mapa e confirmar que você está perto do lugar no check-in."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lero uses the camera only when you choose to take a photo of a place to send. The photo is reviewed before it appears in the app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Lero usa a câmera só quando você escolhe tirar uma foto de um lugar para enviar. A foto passa por análise antes de aparecer no app."
          }
        }
      }
    }
  },
  "version" : "1.0"
