    "userPhotos.terms.ai.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The automatic review sends a smaller copy of the photo to an artificial intelligence model run by Cloudflare, which answers and doesn't keep the image or use it to train models."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise automática envia uma cópia reduzida da foto para um modelo de inteligência artificial da Cloudflare, que responde e não guarda a imagem nem a usa para treinar modelos."
          }
        }
      }
    },
    "userPhotos.terms.ai.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
