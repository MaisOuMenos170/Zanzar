    "userPhotos.terms.birthDate.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You must be 18 or older to send photos. We use the date only to check your age; it isn't stored."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso ter 18 anos ou mais para enviar fotos. Usamos a data só para conferir a idade; ela não fica guardada."
          }
        }
      }
    },
    "userPhotos.terms.birthDate.title": {
      "extractionState": "manual",
      "localizations": {
