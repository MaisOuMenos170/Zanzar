          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Data de nascimento"
          }
        }
      }
    },
    "userPhotos.terms.control.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your photos anytime in Profile > My photos; they disappear from the app and our servers. To report someone else's photo, tap the ••• menu on it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague suas fotos quando quiser em Perfil > Minhas fotos; elas somem do app e dos nossos servidores. Para denunciar a foto de outra pessoa, toque no menu ••• sobre ela."
          }
        }
      }
    },
    "userPhotos.terms.control.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting and reporting"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar e denunciar"
          }
        }
      }
    },
    "userPhotos.terms.data.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use the photo only to show it on the place. It is stored privately while it's in the app; a photo that isn't approved is deleted after 30 days. To access, correct or delete your data, use the contact in Photos and privacy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usamos a foto só para mostrá-la no lugar. Ela fica guardada de forma privada enquanto estiver no app; foto não aprovada é apagada em 30 dias. Para acessar, corrigir ou apagar seus dados, use o contato em Fotos e privacidade."
          }
        }
      }
    },
    "userPhotos.terms.data.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados"
          }
        }
      }
    },
    "userPhotos.terms.error.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save now. Try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar agora. Tente de novo."
          }
        }
      }
    },
    "userPhotos.terms.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you send your first photo, here's how it works. You can read this again anytime in Profile > Photos and privacy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de enviar sua primeira foto, veja como funciona. Você pode reler isto quando quiser em Perfil > Fotos e privacidade."
          }
        }
      }
    },
    "userPhotos.terms.license.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo stays yours. By sending it you give Lero a free, non-exclusive license to show it in the app, which ends when you delete it. Your username appears as the credit unless you choose to stay anonymous."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto continua sua. Ao enviar, você dá ao Lero uma licença gratuita e não exclusiva para mostrá-la no app, que termina quando você a apaga. Seu nome de usuário aparece como crédito, a menos que você escolha ficar anônimo."
          }
        }
      }
    },
    "userPhotos.terms.license.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your license and credit"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua licença e seu crédito"
          }
        }
      }
    },
    "userPhotos.terms.location.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before it leaves your phone, the photo is resized and loses all hidden data: location (GPS), phone model and date."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de sair do seu celular, a foto é reduzida e perde todos os dados escondidos: localização (GPS), modelo do aparelho e data."
          }
        }
      }
    },
    "userPhotos.terms.location.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location removed"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Localização removida"
          }
        }
      }
    },
    "userPhotos.terms.notAllowed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognizable people in the foreground, children and teenagers, nudity, violence, watermarks, photos taken by someone else or from the internet, and photos that don't show the place. Don't send the same photo twice."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pessoas reconhecíveis em primeiro plano, crianças e adolescentes, nudez, violência, marca d'água, foto de outra pessoa ou tirada da internet e foto que não mostra o lugar. Não envie a mesma foto duas vezes."
          }
        }
      }
    },
    "userPhotos.terms.notAllowed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What isn't allowed"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que não pode"
          }
        }
      }
    },
    "userPhotos.terms.review.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every photo goes through an automatic review and, when in doubt, a person on the Lero team. Others only see it once it's approved. Until then only you see it, marked \"in review\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda foto passa por uma análise automática e, na dúvida, por uma pessoa da equipe do Lero. Os outros só a veem depois de aprovada. Até lá, só você vê, marcada como \"em análise\"."
          }
        }
      }
    },
    "userPhotos.terms.review.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviewed before it's published"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Análise antes de publicar"
          }
        }
      }
    },
    "userPhotos.terms.timing.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The automatic review takes a few minutes. When a person has to look, it can take a few days. The app tells you when it's done."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise automática leva poucos minutos. Quando uma pessoa precisa olhar, pode levar alguns dias. O app avisa quando sair o resultado."
          }
        }
      }
    },
    "userPhotos.terms.timing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long it takes"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto tempo leva"
          }
        }
      }
    },
    "userPhotos.terms.underage.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only people aged 18 or older can send photos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
