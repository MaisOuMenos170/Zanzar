    "proximityPermission.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lero lets you know when you pass near a place or the next stop on your route, only a few times a day. To work with the app closed, it needs notifications and “Always” location."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lero avisa quando você passa perto de um lugar ou da próxima parada do seu roteiro, poucas vezes por dia. Para funcionar com o app fechado, ele precisa de notificações e da localização “Sempre”."
          }
        }
      }
    },
